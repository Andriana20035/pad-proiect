# Proxy configuration
LAB3_PROXY_PORT=18080
LAB3_BACKENDS=http://127.0.0.1:9011,http://127.0.0.1:9012
LAB3_CACHE_TTL_MS=2000
LAB3_STALE_IF_ERROR_MS=15000
LAB3_MAX_CONCURRENT=12
LAB3_BACKEND_TIMEOUT_MS=700
LAB3_CB_THRESHOLD=3
LAB3_CB_OPEN_MS=1500
# Warehouse nodes use a single storage synchronization service.
LAB3_STORAGE_URL=http://127.0.0.1:9020
# Storage process; not shared filesystem writes by both DWs.
LAB3_DATA_FILE=data/warehouse.properties
