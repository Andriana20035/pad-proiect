<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
 <xs:element name="order">
  <xs:complexType><xs:sequence>
   <xs:element name="id"><xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[A-Za-z0-9_-]{1,64}"/></xs:restriction></xs:simpleType></xs:element>
   <xs:element name="status"><xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[A-Z_]{1,32}"/></xs:restriction></xs:simpleType></xs:element>
  </xs:sequence></xs:complexType>
 </xs:element>
</xs:schema>
